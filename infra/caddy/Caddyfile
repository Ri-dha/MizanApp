# Production entry point. SITE_ADDRESS is the public host (TLS certificates are obtained
# automatically) or ":80" behind another proxy.
{$SITE_ADDRESS}

encode zstd gzip

handle /api/* {
    reverse_proxy api:8080
}

handle /actuator/health* {
    reverse_proxy api:8080
}

# ADR storage-4: receipt and backup links are signed for this site, path-style, so the bucket's
# path goes to storage as is; neither the path nor Host may change or the signature breaks.
handle /{$MIZAN_STORAGE_BUCKET:mizan-attachments}/* {
    reverse_proxy seaweedfs:8333
}

handle /docs/* {
    root * /srv
    file_server
}

handle {
    root * /srv
    # The service worker and manifest must never be served stale.
    @sw path /sw.js /manifest.webmanifest /registerSW.js
    header @sw Cache-Control "no-cache"
    header /assets/* Cache-Control "public, max-age=31536000, immutable"
    try_files {path} /index.html
    file_server
}

import security-headers.caddy
