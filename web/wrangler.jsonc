{
  // ADR deploy-cf-1: `npm run cf:deploy` builds the site and publishes it with this Worker.
  "name": "mizan",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the API goes through the Worker; files are served straight from the assets.
    "run_worker_first": ["/api/*"]
  },
  // Set per deployment: npx wrangler deploy --var API_ORIGIN:https://api.example
  "vars": { "API_ORIGIN": "" }
}
